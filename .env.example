# ==========================================
# NEXUS WAYS - Root Environment Example
# ==========================================

# Backend API Configuration (apps/api)
PORT=4000
NODE_ENV=development
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_JWT_SECRET=<your-jwt-secret>
COOKIE_DOMAIN=localhost
FRONTEND_ORIGIN=https://smart-supply-chain-v3.web.app,http://localhost:5173,http://localhost:3000

# Frontend Web Configuration (apps/web)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
# In local development:
# VITE_API_URL=http://localhost:4000
# VITE_SOCKET_URL=http://localhost:4000
# In production (.env.production):
# VITE_API_URL=https://<REAL-BACKEND-DOMAIN>
# VITE_SOCKET_URL=https://<REAL-BACKEND-DOMAIN>
