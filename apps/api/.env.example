# ==========================================
# NEXUS WAYS - API Backend Environment Example
# ==========================================

# Server Port (assigned by host in production, e.g. Railway/Render/Cloud Run)
PORT=4000

# Environment Mode ('development' or 'production')
# In production, set to production so cookies use sameSite: 'none' and secure: true
NODE_ENV=development

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>

# Frontend Origins allowed by CORS (comma-separated)
# In production, ensure https://smart-supply-chain-v3.web.app is included
FRONTEND_ORIGIN=https://smart-supply-chain-v3.web.app,http://localhost:5173,http://localhost:3000

# Cookie Domain (Leave empty in production so cookie is set on the backend domain, or set to your custom domain)
# For local development only: localhost
COOKIE_DOMAIN=localhost

# Optional: Gemini API Key for NL2SQL / AI chat features
GEMINI_API_KEY=
